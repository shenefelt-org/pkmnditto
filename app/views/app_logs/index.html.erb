<p style="color: green"><%= notice %></p>

<% content_for :title, "App logs" %>

<h1>App logs</h1>

<div id="app_logs">
  <% @app_logs.each do |app_log| %>
    <%= render app_log %>
    <p>
      <%= link_to "Show this app log", app_log %>
    </p>
  <% end %>
</div>

<%= link_to "New app log", new_app_log_path %>
