<div id="<%= dom_id app_log %>">
  <div>
    <strong>Level:</strong>
    <%= app_log.level %>
  </div>

  <div>
    <strong>Message:</strong>
    <%= app_log.message %>
  </div>

  <div>
    <strong>Ip address:</strong>
    <%= app_log.ip_address %>
  </div>

  <div>
    <strong>User:</strong>
    <%= app_log.user_id %>
  </div>

</div>
